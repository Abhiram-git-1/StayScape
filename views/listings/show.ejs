<% layout("/layouts/boilerplate.ejs") %>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <h3>
                <b>
                    <%= listing.title %>
                </b><br>
            </h3>
        </div>
    </div>
    <div class="container show-page">

        <div class="row">

            <!-- LEFT CONTENT -->
            <div class="col-lg-8">

                <!-- Image -->
                <div class="show-card">

                    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing image"
                        loading="lazy">

                    <div class="cardbody mt-3">

                        <p class="cardtext">

                            Hosted by
                            <b>
                                <%= listing.owner.username %>
                            </b>

                            <br><br>

                            <%= listing.description %>

                                <br><br>

                                <b>Location:</b>
                                <%= listing.location %>,
                                    <%= listing.country %>

                        </p>

                    </div>

                </div>

            </div>

            <!-- RIGHT BOOKING CARD -->
            <div class="col-lg-4">

                <div class="booking-card ">

                    <h4>
                        ₹<%= listing.price.toLocaleString("en-IN") %>
                            <span class="night-text">night</span>
                    </h4>

                    <% if(currentUser) { %>

                        <form action="/bookings/<%= listing._id %>" method="POST">

                            <!-- Dates -->
                            <div class="booking-dates">

                                <div class="date-field">

                                    <label>CHECK-IN</label>

                                    <input type="text" name="checkIn" id="checkIn" required class="form-control">

                                </div>

                                <div class="date-field">

                                    <label>CHECK-OUT</label>

                                    <input type="text" name="checkOut" id="checkOut" required class="form-control">

                                </div>

                            </div>

                            <button class="reserve-btn">

                                Reserve

                            </button>

                            <div class="price-summary">

                                <div class="price-row">

                                    <span>
                                        ₹<%= listing.price.toLocaleString("en-IN") %> ×
                                            <span id="nightCount">0</span> nights
                                    </span>

                                    <span id="subtotalPrice">

                                        ₹0

                                    </span>

                                </div>

                                <div class="price-row">

                                    <span>Taxes (18%)</span>

                                    <span id="taxPrice">

                                        ₹0

                                    </span>

                                </div>

                                <hr>

                                <div class="price-row total-row">

                                    <strong>Total</strong>

                                    <strong id="totalPrice">

                                        ₹0

                                    </strong>

                                </div>

                            </div>

                        </form>

                        <% } else { %>

                            <a href="/users/login" class="reserve-btn login-btn">
                                Login to Book
                            </a>

                            <% } %>

                                <p class="booking-note">
                                    You won't be charged yet
                                </p>

                </div>

            </div>

        </div>

    </div>

    <br><br>
    <% if(currentUser && currentUser._id.equals(listing.owner._id)) {%>
        <div class="btns">
            <a href="/listings/<%= listing._id%>/edit" class="btn btn-primary offset-3"> Edit Listing</a>

            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                <button class="btn btn-dark">Delete</button>
            </form>
        </div>
        <% } %>

            <div class="col-6 offset-3 mt-4">
                <h4>Where you'll be</h4>
                <div id="map"
                    data-coordinates='<%= JSON.stringify(listing.geometry ? listing.geometry.coordinates : [78.4867, 17.3850]) %>'
                    data-location="<%= listing.location %>" data-token="<%= mapToken %>"></div>
            </div>

            <div class="col-8 offset-3 mb-3">

                <% if(currentUser) { %>
                    <hr>
                    <h4>Leave a Review</h4>
                    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate
                        class="needs-validation">
                        <div class="mb-3 mt-3">
                            <label class="form-label">Rating</label>

                            <!-- ⭐⭐⭐⭐⭐ STAR RATING START -->
                            <div class="star-rating">
                                <input type="radio" id="star5" name="review[rating]" value="5" required />
                                <label for="star5" title="5 stars">★</label>

                                <input type="radio" id="star4" name="review[rating]" value="4" />
                                <label for="star4" title="4 stars">★</label>

                                <input type="radio" id="star3" name="review[rating]" value="3" />
                                <label for="star3" title="3 stars">★</label>

                                <input type="radio" id="star2" name="review[rating]" value="2" />
                                <label for="star2" title="2 stars">★</label>

                                <input type="radio" id="star1" name="review[rating]" value="1" />
                                <label for="star1" title="1 star">★</label>
                            </div>
                            <!-- STAR RATING END -->
                        </div>
                        <div class="mb-3 mt-3">
                            <label for="comment" class="form-label">Comment</label>
                            <textarea name="review[comment]" id="comment" cols="30" row="30" required
                                class="form-control"></textarea>
                            <div class="invalid-feedback">Please provide a comment.</div>
                        </div><br>
                        <button class="btn btn-outline-dark">Submit</button>
                    </form>
                    <hr>
                    <% } %>

                        <% if (listing.reviews.length>0 ) { %>
                            <div class="row ">
                                <h4>Reviews</h4>
                                <% for (let review of listing.reviews) { %>
                                    <div class="review-card col-5 ms-3 mb-3">
                                        <div class="cardbody">
                                            <h5 class="card-title"><i class="fa-solid fa-user"></i>
                                                <%= review.author.username %>
                                            </h5>
                                            <!-- review.author?.username || "Anonymous"  -->
                                            <p class="cardtext">
                                                Rating: <%= "★" .repeat(review.rating) + "☆" .repeat(5 - review.rating)
                                                    %><br>
                                                    Comment: <%= review.comment %><br>
                                            </p>
                                        </div>
                                        <form
                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                            method="POST">
                                            <button class="btn btn-sm btn-danger">Delete</button>
                                        </form>
                                    </div>
                                    <% } %>
                            </div>
                            <% } %>
            </div>
            </div>
            </div>
            </div>

            <!-- Flatpickr CSS -->

            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">


            <!-- Flatpickr JS -->

            <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>


            <!-- Dynamic booking data -->

            <script>
                window.bookedDates =
        <%- JSON.stringify(bookedDates) %>;

                window.listingPrice =
                    Number("<%= listing.price %>");
            </script>


            <!-- Booking functionality -->

            <script src="/js/booking.js"></script>


            <!-- Map functionality -->
            <script src="https://api.mapbox.com/mapbox-gl-js/v3.20.0/mapbox-gl.js"></script>

            <script src="/js/map.js"></script>