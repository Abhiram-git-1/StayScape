<% layout("/layouts/boilerplate.ejs") %>

    <style>
        .preview-img {
            width: 250px;
            height: 160px;
            object-fit: cover;
            border-radius: 10px;
            display: block;
        }
    </style>

    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h1>Edit Listing</h1>
            <br>

            <form action="/listings/<%= listing._id %>?_method=PUT" method="POST" novalidate class="needs-validation"
                enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label">Title</label>
                    <input type="text" name="listing[title]" value="<%= listing.title %>" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control"
                        required><%= listing.description %></textarea>
                </div>

                <div class="row">

                    <div class="mb-3 col-md-4">
                        <label class="form-label">Price</label>
                        <input type="number" name="listing[price]" value="<%= listing.price %>" class="form-control"
                            required>
                    </div>

                    <div class="mb-3 col-md-8">
                        <label class="form-label">Location</label>
                        <input type="text" name="listing[location]" value="<%= listing.location %>" class="form-control"
                            required>
                    </div>

                </div>

                <div class="mb-3">
                    Original Listing Image <br>
                    <img src="<%= originalImageUrl %>" class="preview-img" alt="listing image">
                </div>

                <div class="mb-3">
                    <label class="form-label">Upload New Image </label>
                    <input type="file" name="listing[image]" class="form-control">
                </div>

                <div class="mb-3">
                    <label class="form-label">Country</label>
                    <input type="text" name="listing[country]" value="<%= listing.country %>" class="form-control"
                        required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Category</label>

                    <select name="listing[category]" class="form-select" required>

                        <option value="trending" <%=listing.category==="trending" ? "selected" : "" %>>
                            🔥 Trending
                        </option>

                        <option value="beach" <%=listing.category==="beach" ? "selected" : "" %>>
                            🏖 Beach
                        </option>

                        <option value="mountains" <%=listing.category==="mountains" ? "selected" : "" %>>
                            ⛰ Mountains
                        </option>

                        <option value="iconic cities" <%=listing.category==="iconic cities" ? "selected" : "" %>>
                            🏙 Iconic Cities
                        </option>

                        <option value="lake" <%=listing.category==="lake" ? "selected" : "" %>>
                            🌊 Lake
                        </option>

                        <option value="arctic" <%=listing.category==="arctic" ? "selected" : "" %>>
                            ❄ Arctic
                        </option>

                        <option value="camping" <%=listing.category==="camping" ? "selected" : "" %>>
                            🏕 Camping
                        </option>

                        <option value="countryside" <%=listing.category==="countryside" ? "selected" : "" %>>
                            🌾 Countryside
                        </option>

                        <option value="luxury" <%=listing.category==="luxury" ? "selected" : "" %>>
                            💎 Luxury
                        </option>

                    </select>
                </div>

                <button class="btn btn-primary mt-3">Update Listing</button>

            </form>
        </div>
    </div>