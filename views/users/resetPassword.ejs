<% layout("/layouts/boilerplate") %>

    <div class="container d-flex justify-content-center align-items-center min-vh-100">

        <div class="card shadow-lg border-0 rounded-4 p-4 auth-card">

            <div class="text-center mb-4">

                <h1 class="fw-bold">
                    Reset Password
                </h1>

                <p class="text-muted">
                    Enter your new password
                </p>

            </div>

            <form action="/users/reset-password/<%= token %>" method="POST">

                <div class="mb-3">

                    <label class="form-label fw-semibold">

                        New Password

                    </label>

                    <input type="password" name="password" class="form-control form-control-lg rounded-3" required>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-semibold">

                        Confirm Password

                    </label>

                    <input type="password" name="confirmPassword" class="form-control form-control-lg rounded-3"
                        required>

                </div>

                <button class="btn btn-dark btn-lg w-100 rounded-3">

                    Reset Password

                </button>

            </form>

        </div>

    </div>

    <style>
        .auth-card {

            width: 100%;
            max-width: 450px;
        }

        .form-control:focus {

            box-shadow: none;

            border-color: #212529;
        }
    </style>