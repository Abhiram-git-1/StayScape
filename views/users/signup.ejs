<% layout("/layouts/boilerplate") %>

    <div class="container d-flex justify-content-center align-items-center min-vh-100">

        <div class="card shadow-lg border-0 rounded-4 p-4 auth-card">

            <div class="text-center mb-4">

                <h1 class="fw-bold">
                    Create Account
                </h1>

                <p class="text-muted">
                    Join StayScape and start exploring amazing stays
                </p>

            </div>


            <form action="/users/signup" method="POST" novalidate class="needs-validation">

                <!-- USERNAME -->

                <div class="mb-3">

                    <label for="username" class="form-label fw-semibold">
                        Username
                    </label>

                    <input type="text" name="username" id="username" class="form-control form-control-lg rounded-3"
                        placeholder="Choose a username" required>

                    <div class="invalid-feedback">
                        Please enter username.
                    </div>

                </div>


                <!-- EMAIL -->

                <div class="mb-3">

                    <label for="email" class="form-label fw-semibold">
                        Email Address
                    </label>

                    <input type="email" name="email" id="email" class="form-control form-control-lg rounded-3"
                        placeholder="Enter your email" required>

                    <div class="invalid-feedback">
                        Please enter valid email.
                    </div>

                </div>


                <!-- PASSWORD -->

                <div class="mb-3">

                    <label for="password" class="form-label fw-semibold">
                        Password
                    </label>

                    <div class="input-group">

                        <input type="password" name="password" id="password" class="form-control form-control-lg"
                            placeholder="Create a password" required>

                        <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                            <i class="fa-solid fa-eye"></i>
                        </button>

                    </div>

                    <small class="text-muted">
                        Minimum 8 characters recommended.
                    </small>

                    <div id="passwordStrength"></div>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="mb-4">

                    <label for="confirmPassword" class="form-label fw-semibold">
                        Confirm Password
                    </label>

                    <div class="input-group">

                        <input type="password" id="confirmPassword" class="form-control form-control-lg"
                            placeholder="Confirm password" required>

                        <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPassword">
                            <i class="fa-solid fa-eye"></i>
                        </button>

                    </div>

                    <div id="passwordMatch"></div>

                </div>


                <!-- SIGNUP -->

                <button class="btn btn-dark btn-lg w-100 rounded-3">
                    Create Account
                </button>


                <!-- DIVIDER -->

                <div class="divider">
                    <span>OR</span>
                </div>


                <!-- GOOGLE -->

                <a href="/users/google" class="btn btn-outline-dark btn-lg w-100 rounded-3">
                    Continue with Google
                </a>

            </form>


            <hr class="my-4">


            <!-- LOGIN -->

            <div class="text-center">

                <p class="mb-0 text-muted">

                    Already have an account?

                    <a href="/users/login" class="text-decoration-none fw-semibold">
                        Login
                    </a>

                </p>

            </div>

        </div>

    </div>

    <script src="/js/auth.js"></script>