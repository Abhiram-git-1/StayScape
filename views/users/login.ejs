<% layout("/layouts/boilerplate") %>

    <div class="container d-flex justify-content-center align-items-center min-vh-100">

        <div class="card shadow-lg border-0 rounded-4 p-4 auth-card">

            <div class="text-center mb-3">

                <h1 class="fw-bold">
                    Welcome Back
                </h1>

                <p class="text-muted">
                    Login to continue your journey on StayScape
                </p>

            </div>

            <form action="/users/login" method="POST" novalidate class="needs-validation">

                <div class="mb-2">

                    <label for="username" class="form-label fw-semibold">
                        Username
                    </label>

                    <input type="text" name="username" id="username" class="form-control form-control-lg rounded-3"
                        placeholder="Enter username" required>

                    <div class="invalid-feedback">
                        Please enter username.
                    </div>

                </div>


                <div class="mb-2">

                    <label for="password" class="form-label fw-semibold">
                        Password
                    </label>

                    <div class="input-group">

                        <input type="password" name="password" id="password" class="form-control form-control-lg"
                            placeholder="Enter password" required>

                        <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                            <i class="fa-solid fa-eye"></i>
                        </button>

                    </div>

                    <div class="invalid-feedback">
                        Please enter password.
                    </div>

                </div>


                <div class="d-flex justify-content-end mb-3">

                    <a href="/users/forgot-password" class="text-decoration-none small">
                        Forgot Password?
                    </a>

                </div>


                <div class="text-center mt-2">

                    <a href="/users/resend-verification" class="small text-decoration-none">
                        Didn't receive verification email?
                    </a>

                </div>


                <button class="btn btn-dark btn-lg w-100 rounded-3">
                    Login
                </button>


                <div class="divider">
                    <span>OR</span>
                </div>


                <a href="/users/google" class="btn btn-outline-dark btn-lg w-100 rounded-3 mt-2">
                    Continue with Google
                </a>

            </form>


            <hr class="my-3">


            <div class="text-center">

                <p class="mb-0 text-muted">

                    Don't have an account?

                    <a href="/users/signup" class="text-decoration-none fw-semibold">
                        Sign Up
                    </a>

                </p>

            </div>

        </div>

    </div>

    <script src="/js/auth.js"></script>